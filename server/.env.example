# LabelScan Server — Runtime secrets (NEVER commit this file)
# Copy from .env.example and fill in real values

# OCR provider — required for the worker to process extractions
LABELSCAN_OCR_PROVIDER=google
LABELSCAN_GOOGLE_VISION_API_KEY=your-google-vision-api-key-here

# LLM provider — Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Immutable raw/photo storage. Keep filesystem only for local development.
LABELSCAN_OBJECT_STORE=filesystem
LABELSCAN_RAW_STORE_DIR=/app/data/raw
# Production:
# LABELSCAN_OBJECT_STORE=s3
# LABELSCAN_S3_BUCKET=labelscan-production-private
# LABELSCAN_S3_REGION=eu-west-3
# LABELSCAN_S3_ENDPOINT_URL=
# LABELSCAN_S3_ENCRYPTION=aws:kms
# LABELSCAN_S3_KMS_KEY_ID=your-kms-key-id

# Observability — structured JSON logs on stdout (level: DEBUG|INFO|WARNING|ERROR)
# LABELSCAN_LOG_LEVEL=INFO

# Optional: override the default LLM model (default: claude-haiku-4-5 — hybrid
# pipeline, GS1 handles exact fields). Use Opus/Sonnet for higher precision.
# LABELSCAN_LLM_MODEL=claude-opus-4-8

# --- Confidence thresholds (calibrated, NOT guessed) ---------------------------
# Combined-confidence cutoff under which a required field is sent to human review,
# and the band boundaries. Defaults below = current behaviour (no change if unset).
# CALIBRATE on real labelled data: python scripts/calibrate_confidence.py data.json
# Haiku is less precise than Opus → calibrate (or set a higher review_below, e.g.
# 0.85, conservatively) before relying on auto-accept. Bump the rule-set version
# when you change these so each extraction_run records which calibration it used.
# LABELSCAN_REVIEW_BELOW=0.70
# LABELSCAN_BAND_MEDIUM_AT=0.70
# LABELSCAN_BAND_HIGH_AT=0.90

# --- Auth (simple admin JWT) ---------------------------------------------------
# Signing secret for the HS256 access tokens — REQUIRED, at least 32 bytes
# (RFC 7518 §3.2). Generate e.g. with: python -c "import secrets;print(secrets.token_urlsafe(48))"
LABELSCAN_JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-bytes
# Optional: access-token lifetime in seconds (default 43200 = 12h).
# LABELSCAN_JWT_TTL_SECONDS=43200
# Optional: accept legacy X-Actor-Id/X-Principal/X-Scopes headers from a TRUSTED
# upstream gateway. Default OFF — never enable when clients reach the API directly.
# LABELSCAN_ALLOW_HEADER_AUTH=0

# Admin provisioning — used once by:
#   python -m labelscan.contexts.identity.adapters.cli
LABELSCAN_ADMIN_USERNAME=admin
LABELSCAN_ADMIN_PASSWORD=change-me-to-a-strong-password
