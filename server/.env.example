# Serveur: copier dans .env et renseigner les secrets. Ne jamais le publier.

# OCR
LABELSCAN_OCR_PROVIDER=google
LABELSCAN_GOOGLE_VISION_API_KEY=your-google-vision-api-key-here
# LABELSCAN_GOOGLE_VISION_API_KEY_FILE=/run/secrets/google_vision_api_key

# IA
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key

# Stockage
LABELSCAN_OBJECT_STORE=filesystem
LABELSCAN_RAW_STORE_DIR=/app/data/raw
# LABELSCAN_OBJECT_STORE=s3
# LABELSCAN_S3_BUCKET=labelscan-production-private
# LABELSCAN_S3_REGION=eu-west-3
# LABELSCAN_S3_ENDPOINT_URL=
# LABELSCAN_S3_ENCRYPTION=aws:kms
# LABELSCAN_S3_KMS_KEY_ID=your-kms-key-id

# Réglages optionnels
# LABELSCAN_LOG_LEVEL=INFO
# LABELSCAN_LLM_MODEL=claude-opus-4-8
# LABELSCAN_LLM_PROMPT_CACHE_ENABLED=1
# LABELSCAN_LLM_PROMPT_CACHE_TTL=5m
# LABELSCAN_LLM_PROMPT_CACHE_1H_VERIFIED=0
# LABELSCAN_LLM_ESCALATION_ENABLED=0
# LABELSCAN_LLM_ESCALATION_MODEL=claude-opus-4-8

# Limites par worker
# LABELSCAN_GOOGLE_VISION_RPS=5
# LABELSCAN_ANTHROPIC_RPS=2
# LABELSCAN_PROVIDER_MAX_ATTEMPTS=6

# Confiance
# LABELSCAN_REVIEW_BELOW=0.70
# LABELSCAN_BAND_MEDIUM_AT=0.70
# LABELSCAN_BAND_HIGH_AT=0.90

# Auth: secret JWT d'au moins 32 octets
LABELSCAN_JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-bytes
# LABELSCAN_JWT_SECRET_FILE=/run/secrets/jwt_secret
# LABELSCAN_JWT_ISSUER=https://labelscan.example
# LABELSCAN_JWT_AUDIENCE=labelscan-clients
# LABELSCAN_VERSION=git-sha-or-release-id
# LABELSCAN_JWT_TTL_SECONDS=900
# LABELSCAN_REFRESH_TTL_SECONDS=604800
# LABELSCAN_ALLOW_HEADER_AUTH=0
# LABELSCAN_TRUSTED_PROXIES=127.0.0.1
# LABELSCAN_PUBLIC_ORIGIN=https://labelscan.example
# LABELSCAN_ALLOWED_HOSTS=labelscan.example

# Limites API
# LABELSCAN_LOGIN_RATE_LIMIT=5
# LABELSCAN_LOGIN_RATE_WINDOW_SECONDS=60
# LABELSCAN_LOGIN_ACCOUNT_FAILURES=5
# LABELSCAN_LOGIN_ACCOUNT_COOLDOWN_SECONDS=60
# 60 uploads / 10 min leaves headroom above the operational target of 40 arrivals.
# LABELSCAN_INGESTION_BURST_LIMIT=60
# LABELSCAN_INGESTION_BURST_WINDOW_SECONDS=600
# LABELSCAN_INGESTION_SUSTAINED_LIMIT=360
# LABELSCAN_INGESTION_SUSTAINED_WINDOW_SECONDS=3600
# LABELSCAN_MUTATION_LIMIT=600
# LABELSCAN_MUTATION_WINDOW_SECONDS=3600
# LABELSCAN_LONG_POLL_PER_ACTOR=4
# LABELSCAN_LONG_POLL_GLOBAL=100

# Compte administrateur
LABELSCAN_ADMIN_USERNAME=admin
LABELSCAN_ADMIN_PASSWORD=change-me-to-a-strong-password

# Base de données locale
POSTGRES_DB=labelscan_test
POSTGRES_USER=labelscan_app_local
POSTGRES_PASSWORD=generate-a-long-random-local-password
DATABASE_URL=postgresql+psycopg://labelscan_app_local:url-encoded-password@db:5432/labelscan_test
# DATABASE_URL_FILE=/run/secrets/database_url

# development | test | production
LABELSCAN_ENV=development
