# LabelScan Server — Runtime secrets (NEVER commit this file)
# Copy from .env.example and fill in real values

# OCR provider — required for the worker to process extractions
LABELSCAN_OCR_PROVIDER=google
LABELSCAN_GOOGLE_VISION_API_KEY=your-google-vision-api-key-here
# Production alternative: LABELSCAN_GOOGLE_VISION_API_KEY_FILE=/run/secrets/google_vision_api_key

# LLM provider — Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Production alternative: ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key

# Immutable raw/photo storage. Keep filesystem only for local development.
LABELSCAN_OBJECT_STORE=filesystem
LABELSCAN_RAW_STORE_DIR=/app/data/raw
# Production:
# LABELSCAN_OBJECT_STORE=s3
# LABELSCAN_S3_BUCKET=labelscan-production-private
# LABELSCAN_S3_REGION=eu-west-3
# LABELSCAN_S3_ENDPOINT_URL=
# LABELSCAN_S3_ENCRYPTION=aws:kms
# LABELSCAN_S3_KMS_KEY_ID=your-kms-key-id

# Observability — structured JSON logs on stdout (level: DEBUG|INFO|WARNING|ERROR)
# LABELSCAN_LOG_LEVEL=INFO

# Optional: override the default LLM model (default: claude-haiku-4-5 — hybrid
# pipeline, GS1 handles exact fields). Use Opus/Sonnet for higher precision.
# LABELSCAN_LLM_MODEL=claude-opus-4-8
# Static prompt caching is requested by default, with a strict five-minute TTL.
# The worker measures the exact static prefix with Anthropic count_tokens once per
# model/process and disables caching if it does not clear the model-specific floor.
# LABELSCAN_LLM_PROMPT_CACHE_ENABLED=1
# LABELSCAN_LLM_PROMPT_CACHE_TTL=5m
# One-hour writes require an independently measured reuse window and this explicit
# acknowledgement in addition to LABELSCAN_LLM_PROMPT_CACHE_TTL=1h.
# LABELSCAN_LLM_PROMPT_CACHE_1H_VERIFIED=0
# Optional second tier; disabled unless explicitly enabled and calibrated.
# LABELSCAN_LLM_ESCALATION_ENABLED=0
# LABELSCAN_LLM_ESCALATION_MODEL=claude-opus-4-8

# --- External-provider capacity (per worker process) -------------------------
# Maximum requests/second sent to each provider by ONE worker. Defaults are 5
# for Google Vision and 2 for Anthropic. Set these from the provider account quota
# divided by the number of worker replicas (two in docker-compose.yml). Each worker
# emits safe JSON counters named `external_api_metrics` once a minute.
# LABELSCAN_GOOGLE_VISION_RPS=5
# LABELSCAN_ANTHROPIC_RPS=2

# --- Confidence thresholds (calibrated, NOT guessed) ---------------------------
# Combined-confidence cutoff under which a required field is sent to human review,
# and the band boundaries. Defaults below = current behaviour (no change if unset).
# CALIBRATE on real labelled data: python scripts/calibrate_confidence.py data.json
# Haiku is less precise than Opus → calibrate (or set a higher review_below, e.g.
# 0.85, conservatively) before relying on auto-accept. Bump the rule-set version
# when you change these so each extraction_run records which calibration it used.
# LABELSCAN_REVIEW_BELOW=0.70
# LABELSCAN_BAND_MEDIUM_AT=0.70
# LABELSCAN_BAND_HIGH_AT=0.90

# --- Auth (simple admin JWT) ---------------------------------------------------
# Signing secret for the HS256 access tokens — REQUIRED, at least 32 bytes
# (RFC 7518 §3.2). Generate e.g. with: python -c "import secrets;print(secrets.token_urlsafe(48))"
LABELSCAN_JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-bytes
# Production alternative: LABELSCAN_JWT_SECRET_FILE=/run/secrets/jwt_secret
# Token namespace. Set both explicitly in production to prevent cross-service reuse.
# LABELSCAN_JWT_ISSUER=https://labelscan.example
# LABELSCAN_JWT_AUDIENCE=labelscan-clients
# Immutable release identifier/commit. Mandatory in production.
# LABELSCAN_VERSION=git-sha-or-release-id
# Optional session lifetimes (defaults: access 900s, refresh 604800s).
# LABELSCAN_JWT_TTL_SECONDS=900
# LABELSCAN_REFRESH_TTL_SECONDS=604800
# Optional: accept legacy X-Actor-Id/X-Principal/X-Scopes headers from a TRUSTED
# upstream gateway. Default OFF — never enable when clients reach the API directly.
# LABELSCAN_ALLOW_HEADER_AUTH=0
# Proxy addresses trusted to supply X-Forwarded-For. Keep loopback-only unless the
# API is behind a named reverse proxy network.
# LABELSCAN_TRUSTED_PROXIES=127.0.0.1
# Browser/Host allow-list. Both are mandatory in production.
# LABELSCAN_PUBLIC_ORIGIN=https://labelscan.example
# LABELSCAN_ALLOWED_HOSTS=labelscan.example

# Single-replica MVP abuse-control defaults.
# LABELSCAN_LOGIN_RATE_LIMIT=5
# LABELSCAN_LOGIN_RATE_WINDOW_SECONDS=60
# LABELSCAN_LOGIN_ACCOUNT_FAILURES=5
# LABELSCAN_LOGIN_ACCOUNT_COOLDOWN_SECONDS=60
# LABELSCAN_INGESTION_BURST_LIMIT=20
# LABELSCAN_INGESTION_BURST_WINDOW_SECONDS=600
# LABELSCAN_INGESTION_SUSTAINED_LIMIT=120
# LABELSCAN_INGESTION_SUSTAINED_WINDOW_SECONDS=3600
# LABELSCAN_MUTATION_LIMIT=600
# LABELSCAN_MUTATION_WINDOW_SECONDS=3600
# LABELSCAN_LONG_POLL_PER_ACTOR=4
# LABELSCAN_LONG_POLL_GLOBAL=100

# Admin provisioning — used once by:
#   python -m labelscan.contexts.identity.adapters.cli
LABELSCAN_ADMIN_USERNAME=admin
LABELSCAN_ADMIN_PASSWORD=change-me-to-a-strong-password
# Docker Compose database credentials (local development; choose non-default values)
POSTGRES_DB=labelscan_test
POSTGRES_USER=labelscan_app_local
POSTGRES_PASSWORD=generate-a-long-random-local-password
DATABASE_URL=postgresql+psycopg://labelscan_app_local:url-encoded-password@db:5432/labelscan_test
# Production alternative (must use sslmode=verify-full):
# DATABASE_URL_FILE=/run/secrets/database_url

# Runtime mode: development | test | production. Production enables strict cookies
# and rejects the legacy header-auth seam.
LABELSCAN_ENV=development
