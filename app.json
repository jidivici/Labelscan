{
  "expo": {
    "name": "LabelScan",
    "slug": "LabelScan",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/labelscan-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "LabelScan uses your camera to photograph product labels and scan barcodes."
      },
      "bundleIdentifier": "com.anonymous.LabelScan"
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/labelscan-logo.png",
        "backgroundColor": "#078B7D"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.anonymous.LabelScan"
    },
    "web": {
      "favicon": "./assets/labelscan-logo.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "LabelScan uses your camera to photograph product labels and scan barcodes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "124ba152-f25f-4cdb-ae98-ea1a550561fc"
      }
    }
  }
}
