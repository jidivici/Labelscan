# Every Dockerfile is built with the repository root as its context. Start from
# an empty context, then expose only the three trees referenced by COPY.
**
!server/
!server/**
!web/
!web/**
!deploy/
!deploy/**

# Never send local credentials, dependencies, caches or generated output.
.env
.env.*
**/.env
**/.env.*
**/*.jks
**/*.p8
**/*.p12
**/*.key
**/*.mobileprovision
**/*.pem
**/*.apk
**/*.aab
**/*.ipa
**/*.xcarchive/
**/*.ppt
**/*.pptx
**/*.doc
**/*.docx
**/*.pdf
**/node_modules/
**/.venv/
**/venv/
**/*.egg-info/
**/.pytest_cache/
**/.ruff_cache/
**/.import_linter_cache/
**/__pycache__/
**/*.py[cod]
**/dist/
**/build/
**/coverage/
**/test-results/
**/playwright-report/
**/*.log
**/.DS_Store
server/demo/credentials.local.json
