{
  "info": {
    "_postman_id": "6a4acb65-8b80-4a40-8a3b-b828cd88d7ce",
    "name": "LabelScan API - Security exposure checks",
    "description": "Read-only production probes. They verify the intended public surface and prove that business and ingestion routes reject anonymous or forged identities.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public health endpoint is reachable",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/health/live"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('API is alive', () => pm.expect(pm.response.json().status).to.eql('alive'));",
              "pm.test('Security headers are present', () => {",
              "  pm.expect(pm.response.headers.get('Strict-Transport-Security')).to.include('max-age=31536000');",
              "  pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
              "  pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "OpenAPI documentation is not public",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/openapi.json"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Business API rejects anonymous access",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/arrivals"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('Stable auth error', () => pm.expect(pm.response.json().error_code).to.eql('UNAUTHENTICATED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Forged identity headers are rejected",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Actor-Id",
            "value": "11111111-1111-1111-1111-111111111111"
          },
          {
            "key": "X-Scopes",
            "value": "catalog:read identity:admin"
          }
        ],
        "url": "{{baseUrl}}/v1/arrivals"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('Headers cannot impersonate a user', () => pm.expect(pm.response.json().error_code).to.eql('UNAUTHENTICATED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ingestion rejects anonymous access before processing",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "postman-anonymous-security-probe"
          }
        ],
        "url": "{{baseUrl}}/v1/ingestions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('No anonymous ingestion', () => pm.expect(pm.response.json().error_code).to.eql('UNAUTHENTICATED'));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://label-scan.fr",
      "type": "string"
    }
  ]
}
