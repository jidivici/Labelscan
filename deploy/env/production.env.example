# Non-secret deployment contract. Copy outside Git as production.env and supply it
# with: docker compose --env-file deploy/env/production.env -f deploy/compose/production.yml ...

# Always deploy by immutable registry digest, never by a mutable tag.
LABELSCAN_IMAGE=registry.example/labelscan@sha256:replace-with-reviewed-digest
LABELSCAN_EDGE_NETWORK=labelscan_edge
LABELSCAN_BACKEND_NETWORK=labelscan_backend
LABELSCAN_VERSION=replace-with-release-id-or-commit-sha

LABELSCAN_PUBLIC_ORIGIN=https://labelscan.example
LABELSCAN_ALLOWED_HOSTS=labelscan.example
# Socket peer addresses of the TLS reverse proxies allowed to supply X-Forwarded-For.
LABELSCAN_TRUSTED_PROXIES=172.20.0.10

LABELSCAN_JWT_ISSUER=https://labelscan.example
LABELSCAN_JWT_AUDIENCE=labelscan-clients

LABELSCAN_S3_BUCKET=replace-with-private-bucket
LABELSCAN_S3_REGION=eu-west-3
LABELSCAN_S3_ENDPOINT_URL=
LABELSCAN_S3_KMS_KEY_ID=replace-with-kms-key-arn

# Compose/Swarm secret object names. Secret VALUES are never placed in this file.
LABELSCAN_DATABASE_URL_SECRET=labelscan_database_url
LABELSCAN_JWT_SECRET_NAME=labelscan_jwt_secret
LABELSCAN_GOOGLE_VISION_SECRET=labelscan_google_vision_api_key
LABELSCAN_ANTHROPIC_SECRET=labelscan_anthropic_api_key
