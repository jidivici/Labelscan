# LabelScan mobile — Expo public env. Copy to .env and fill in.
# EXPO_PUBLIC_* values are INLINED at bundle time — restart Metro (clear cache)
# after changing them. Do NOT commit a real .env (it is git-ignored).

# Backend base URL. REQUIRED for the default backend mode. For on-device testing,
# use your machine's LAN IP (not localhost), reachable from the phone.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.177:8000

# Capture path. Backend extraction is the DEFAULT (unset => backend). Set to
# false (or 0) to force the legacy on-device OCR path, which displays text but
# does NOT save articles.
# EXPO_PUBLIC_BACKEND_FIRST=false

# Auth is real JWT now: the app signs in via POST /v1/auth/login (username +
# password) and stores the Bearer token in the secure keystore. There are no
# client-side auth env vars — credentials are entered on the login screen.

# The legacy on-device OCR path (and its EXPO_PUBLIC_GOOGLE_VISION_KEY) was
# REMOVED (audit §7.3): an EXPO_PUBLIC_* key is inlined into the JS bundle and
# extractable from any build. OCR is server-side only (server/.env).
