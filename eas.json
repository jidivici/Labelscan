{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "LABELSCAN_BUILD_PROFILE": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "LABELSCAN_BUILD_PROFILE": "preview",
        "EXPO_PUBLIC_API_BASE_URL": "https://label-scan.fr"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "LABELSCAN_BUILD_PROFILE": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://label-scan.fr"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
